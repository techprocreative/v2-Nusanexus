# Aikeedo Next.js - Production Environment Variables

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Encryption Key (32-byte hex string for AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_encryption_key_here

# Application URL
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# Note: AI Provider credentials are stored encrypted in database
# Note: Payment gateway credentials are stored encrypted in database
